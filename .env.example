# LLM providers — gratuitos (Gemini, Groq confirmados funcionando; NVIDIA/
# OpenCode disponibles pero sin verificar del todo) por defecto. OpenAI
# sigue disponible y activo (de pago, pero funcionando). Cerebras y
# Anthropic quedan sin priorizar por defecto (billing bloqueado / se quedo
# sin credito, issue #17) — ambos vuelven a estar activos con solo
# agregarles su api key y reintroducirlos en PROVIDER_PRIORITY.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# console.groq.com — sin tarjeta de credito segun free-llm-api-resources.
# Verifica el ID de modelo vigente antes de depender de este default.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# cloud.cerebras.ai — sin tarjeta de credito. Limites generosos (14,400 req/dia).
# NOTA: excluido de PROVIDER_PRIORITY por defecto -- la cuenta gratuita se
# quedo con el billing bloqueado (402 Payment required, confirmado real en
# produccion). El codigo del provider se mantiene intacto; se reactiva
# agregando "cerebras" de nuevo a PROVIDER_PRIORITY si se resuelve el billing.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# build.nvidia.com (NIM) — tier de desarrollador gratuito. Verifica el ID de
# modelo vigente en tu consola antes de depender de este default.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-4-scout-17b-16e-instruct
# opencode.ai/zen — "big-pickle" es promocional/gratis por tiempo limitado,
# no un tier gratuito permanente garantizado. Verifica en opencode.ai/docs/zen.
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# The provider used for final synthesis. If unavailable, the first successful provider is used.
SYNTHESIZER_PROVIDER=gemini

# Orden de preferencia del router al elegir un subconjunto de providers.
# Los proveedores gratuitos van primero; openai queda de respaldo al final.
# El router solo usa hasta 3 por request. cerebras no esta en esta lista por
# defecto (ver nota junto a CEREBRAS_API_KEY arriba).
PROVIDER_PRIORITY=gemini,groq,nvidia,opencode,openai

# When true (default), providers that answered successfully critique each
# other's answers before synthesis (only runs with 2+ successful responses).
ENABLE_CROSS_CRITIQUE=true

# When true (default), each provider revises its own answer using the
# critiques it received before synthesis (only runs when cross-critique
# produced at least one usable critique).
ENABLE_REEVALUATION_ROUND=true

# When true (default) and the router detects a coding task, a shared test
# suite is generated and each candidate's code is executed in a sandboxed
# subprocess (timeout + resource limits, no inherited env vars) to attach
# objective PASS/FAIL evidence before synthesis.
ENABLE_CODE_VERIFICATION=true
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_MAX_OUTPUT_CHARS=4000

# Rate limiting y presupuesto diario (desactivados por defecto -- ver
# docs/ARQUITECTURA.md, seccion "Rate limiting y control de presupuesto").
ENABLE_RATE_LIMITING=false
RATE_LIMIT_REQUESTS_PER_MINUTE=20
# Sin definir = sin limite. Si se define, /api/chat y /api/evaluate
# devuelven 402 una vez que el costo real ya persistido hoy lo alcanza.
DAILY_BUDGET_USD=

# Backend
PROVIDER_TIMEOUT_SECONDS=45
MAX_TOKENS_PER_REQUEST=2048
MAX_PROMPT_CHARS=12000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=multillm
POSTGRES_USER=multillm
POSTGRES_PASSWORD=multillm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://multillm:multillm@postgres:5432/multillm

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
