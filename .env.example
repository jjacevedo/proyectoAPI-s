# LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# The provider used for final synthesis. If unavailable, the first successful provider is used.
SYNTHESIZER_PROVIDER=openai

# When true (default), providers that answered successfully critique each
# other's answers before synthesis (only runs with 2+ successful responses).
ENABLE_CROSS_CRITIQUE=true

# When true (default), each provider revises its own answer using the
# critiques it received before synthesis (only runs when cross-critique
# produced at least one usable critique).
ENABLE_REEVALUATION_ROUND=true

# When true (default) and the router detects a coding task, a shared test
# suite is generated and each candidate's code is executed in a sandboxed
# subprocess (timeout + resource limits, no inherited env vars) to attach
# objective PASS/FAIL evidence before synthesis.
ENABLE_CODE_VERIFICATION=true
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_MAX_OUTPUT_CHARS=4000

# Backend
PROVIDER_TIMEOUT_SECONDS=45
MAX_TOKENS_PER_REQUEST=2048
MAX_PROMPT_CHARS=12000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=multillm
POSTGRES_USER=multillm
POSTGRES_PASSWORD=multillm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://multillm:multillm@postgres:5432/multillm

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
