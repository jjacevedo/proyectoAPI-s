# LLM providers — gratuitos (Groq, Cerebras, Gemini free tier) por defecto.
# OpenAI sigue disponible y activo (de pago, pero funcionando). Anthropic
# queda sin key por defecto tras el issue #17 (se quedo sin credito) — vuelve
# a estar activo con solo agregarle una key aqui, sin cambios de codigo.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# console.groq.com — sin tarjeta de credito segun free-llm-api-resources.
# Verifica el ID de modelo vigente antes de depender de este default.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# cloud.cerebras.ai — sin tarjeta de credito. Limites generosos (14,400 req/dia).
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# The provider used for final synthesis. If unavailable, the first successful provider is used.
SYNTHESIZER_PROVIDER=cerebras

# Orden de preferencia del router al elegir un subconjunto de providers.
# Los proveedores gratuitos van primero; openai queda de respaldo al final.
PROVIDER_PRIORITY=cerebras,gemini,groq,openai

# When true (default), providers that answered successfully critique each
# other's answers before synthesis (only runs with 2+ successful responses).
ENABLE_CROSS_CRITIQUE=true

# When true (default), each provider revises its own answer using the
# critiques it received before synthesis (only runs when cross-critique
# produced at least one usable critique).
ENABLE_REEVALUATION_ROUND=true

# When true (default) and the router detects a coding task, a shared test
# suite is generated and each candidate's code is executed in a sandboxed
# subprocess (timeout + resource limits, no inherited env vars) to attach
# objective PASS/FAIL evidence before synthesis.
ENABLE_CODE_VERIFICATION=true
CODE_EXECUTION_TIMEOUT_SECONDS=5
CODE_MAX_OUTPUT_CHARS=4000

# Backend
PROVIDER_TIMEOUT_SECONDS=45
MAX_TOKENS_PER_REQUEST=2048
MAX_PROMPT_CHARS=12000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=multillm
POSTGRES_USER=multillm
POSTGRES_PASSWORD=multillm
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://multillm:multillm@postgres:5432/multillm

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
